<Project>
  <PropertyGroup>
    <TestTargets Condition="'$(LocalBuild)' != 'True'">net8.0</TestTargets>
    <TestTargets Condition="'$(LocalBuild)' == 'True'">net8.0;net9.0</TestTargets>
    <TestTargets Condition="'$(TargetNetNext)'== 'True'">$(TestTargets);</TestTargets>
</PropertyGroup>
</Project>
